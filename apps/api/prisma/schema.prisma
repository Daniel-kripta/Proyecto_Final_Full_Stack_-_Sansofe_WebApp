generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Articulo {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  publication         String
  date                DateTime                 @db.Date
  edition             String?
  source_id           String?
  headline            String
  subheadline         String?
  body                String
  byline              String?
  section             String?
  genre               String
  topics              String[]
  people              String[]
  places              String[]
  summary             String?
  has_image           Boolean?                 @default(false)
  uncertain_fields    String[]
  embedding           Unsupported("vector")?
  event_id            String?                  @db.Uuid
  fts_vector          Unsupported("tsvector")? @default(dbgenerated("(setweight(to_tsvector('spanish'::regconfig, COALESCE(headline, ''::text)), 'A'::\"char\") || setweight(to_tsvector('spanish'::regconfig, COALESCE(body, ''::text)), 'C'::\"char\"))"))
  entities            String[]
  articulos ColeccionArticulo[]

  @@index([date], map: "idx_articulos_fecha")
  @@index([fts_vector], map: "idx_articulos_fts", type: Gin)
  @@map("articulos")
}

model Usuario {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String      @unique
  passwordHash String      @map("password_hash")
  createdAt    DateTime?   @default(now()) @map("created_at") @db.Timestamptz(6)
  colecciones  Coleccion[]

  @@map("usuarios")
}

model Coleccion {
  id         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String?             @map("usuario_id") @db.Uuid
  nombre     String
  createdAt  DateTime?           @default(now()) @map("created_at") @db.Timestamptz(6)
  usuario    Usuario?            @relation(fields: [usuarioId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  articulos  ColeccionArticulo[]

  @@map("colecciones")
}

model ColeccionArticulo {
  coleccionId String    @map("coleccion_id") @db.Uuid
  articuloId  String    @map("articulo_id") @db.Uuid
  nota        String?
  addedAt     DateTime? @default(now()) @map("added_at") @db.Timestamptz(6)
  articulo    Articulo  @relation(fields: [articuloId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coleccion   Coleccion @relation(fields: [coleccionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([coleccionId, articuloId])
  @@map("coleccion_articulos")
}
