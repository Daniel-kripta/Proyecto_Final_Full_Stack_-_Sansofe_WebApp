            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passwordActual\": \"test_postman\",\n  \"passwordNuevo\": \"nueva_contraseña\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
