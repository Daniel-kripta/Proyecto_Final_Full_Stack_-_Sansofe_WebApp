              "host": ["{{base_url}}"],
              "path": ["investigaciones", "{{investigacion_id}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "6. Perfil (requiere auth)",
      "item": [
        {
          "name": "Ver perfil",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/perfil",
              "host": ["{{base_url}}"],
              "path": ["perfil"]
            }
          },
          "response": []
        },
        {
          "name": "Actualizar datos personales",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/perfil/datos",
              "host": ["{{base_url}}"],
              "path": ["perfil", "datos"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Nombre\",\n  \"apellidos\": \"Apellidos\",\n  \"username\": \"mi_alias\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
        },
        {
          "name": "Guardar clave API Gemini",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/perfil",
              "host": ["{{base_url}}"],
              "path": ["perfil"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"geminiApiKey\": \"tu_clave_aqui\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "response": []
